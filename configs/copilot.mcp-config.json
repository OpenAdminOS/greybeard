{
  "mcpServers": {
    "greybeard-graph": {
      "type": "local",
      "command": "node",
      "args": [
        "graph/dist/index.js"
      ],
      "env": {},
      "tools": [
        "*"
      ]
    },
    "greybeard-memory": {
      "type": "local",
      "command": "node",
      "args": [
        "memory/dist/index.js"
      ],
      "env": {},
      "tools": [
        "*"
      ]
    },
    "intuneautomation": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@ugurkocde/intuneautomation-mcp@latest"
      ],
      "env": {},
      "tools": [
        "*"
      ]
    }
  }
}
