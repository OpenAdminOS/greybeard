{
  "mcpServers": {
    "greybeard-memory": {
      "command": "node",
      "args": [
        "cli/dist/index.js",
        "mcp",
        "memory"
      ],
      "env": {
        "GREYBEARD_PROFILE_ID": "local",
        "GREYBEARD_TENANT_ID": "local"
      }
    },
    "microsoft-learn": {
      "url": "https://learn.microsoft.com/api/mcp"
    }
  }
}
